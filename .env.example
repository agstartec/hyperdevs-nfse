# Configuração da biblioteca hyperevs/nfse
# Copie este arquivo para .env e ajuste os valores conforme o ambiente.

# Tipo de ambiente da NFS-e Nacional: 1 = Produção, 2 = Homologação
NFSE_TP_AMB=2

# Código/identificador da prefeitura utilizada para resolver URLs e operações
# (ver Storage/prefeituras.json para os valores suportados)
NFSE_PREFEITURA=

# Tipo de API utilizada na integração: sefin ou adn
NFSE_TIPO_API=sefin
