{
    "name": "hyperdevs/nfse",
    "description": "Biblioteca para integração de NFS-e",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Hyperdevs\\Nfse\\": "src/"
        }
    },
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-curl": "*",
        "ext-zlib": "*",
        "ext-openssl": "*",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0",
        "illuminate/support": "^10.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hyperdevs\\Nfse\\Provider\\NfseProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}